// Same Worker as wrangler.jsonc, with the app packed into the script
// (scripts/bundle-assets.mjs) instead of Workers Assets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "justchords",
  "main": "src/worker/bundled.ts",
  "compatibility_date": "2026-11-01",
  "kv_namespaces": [{ "binding": "USERS", "id": "f43870e697004b0dadb8d2fe9384748c" }],
  "vars": {
    "GOOGLE_CLIENT_ID": "600886543133-tmdg4a42m6vk0iimh705i0gpennvt4li.apps.googleusercontent.com"
  },
  "routes": [{ "pattern": "chords.justapps.it", "custom_domain": true }],
  "workers_dev": true
}
