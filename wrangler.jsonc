{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "justchords",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "chords.justapps.it", "custom_domain": true }],
  "workers_dev": true
}
