{
  "name": "justchords",
  "version": "0.1.0",
  "private": true,
  "description": "Chords, tuner, metronome and stage mode. By justapps.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "asbuild": "asc assembly/index.ts -o public/dsp.wasm -O3 --runtime stub --noAssert",
    "build": "npm run asbuild && tsc -p . && vite build",
    "preview": "vite preview",
    "test": "npm run asbuild && vitest run",
    "deploy": "npm run build && wrangler deploy",
    "release:android": "node scripts/release-android.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "assemblyscript": "^0.28.20",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "wrangler": "^4.167.0"
  }
}
